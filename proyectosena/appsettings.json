{
  // ============================================================
  //  Este archivo SE VERSIONA. Nada de lo que hay aquí es secreto,
  //  y nada secreto puede volver a entrar.
  //
  //  La cadena de conexión, la clave de firma de los tokens y la
  //  contraseña del correo salen del entorno: en local del .env que
  //  lee docker-compose.yml, y al desplegar del panel del proveedor.
  //  Los nombres de todas ellas están en .env.example.
  //
  //  Estuvieron escritas aquí y el repositorio es público: cualquiera
  //  que lo clonara se llevaba unas credenciales que funcionaban.
  //  Si falta la clave de firma, la API no arranca — a propósito.
  // ============================================================

  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    // La clave (Jwt:Key) no está aquí: llega por Jwt__Key.
    "Issuer": "RecyRouteAPI",
    "Audience": "RecyRouteClients",
    "TokenExpirationMinutes": 120
  },
  "EmailSettings": {
    // Ni la contraseña ni el remitente: llegan por EmailSettings__Password
    // y EmailSettings__SenderEmail.
    "Host": "smtp.gmail.com",
    "Port": 587,
    "SenderName": "RecyRoute"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
