# ============================================================
#  Plantilla de configuración de RecyRoute
# ============================================================
#  Este archivo SÍ se sube al repositorio, porque no lleva ningún
#  valor real: solo los nombres de lo que hay que definir.
#
#  Para trabajar en tu equipo: copia este archivo como .env y
#  rellena cada valor. El .env no se sube nunca (está en .gitignore).
#
#  Para desplegar: define estas mismas variables en el panel del
#  proveedor (Render, Railway, Azure...), no subas ningún archivo.
# ============================================================

# ── Base de datos ────────────────────────────────────────────
POSTGRES_DB=RecyRoute
POSTGRES_USER=recyroute
# Genera una contraseña larga y aleatoria. No reutilices ninguna.
POSTGRES_PASSWORD=

# ── Sesiones ─────────────────────────────────────────────────
# Clave con la que se firman los tokens. Mínimo 32 caracteres.
# Quien tenga esta clave puede fabricarse un token de administrador
# sin tocar la base de datos: trátala como la contraseña maestra.
JWT_KEY=
JWT_ISSUER=RecyRouteAPI
JWT_AUDIENCE=RecyRouteClients
# Cuánto dura la sesión. 120 son dos horas; en equipos compartidos
# conviene bajarlo.
JWT_EXPIRATION_MINUTES=120

# ── Orígenes del navegador (CORS) ────────────────────────────
# Desde qué direcciones puede el navegador llamar a la API. En tu
# equipo es Nginx en el 8081. Si algún día el frontend se publica
# aparte, aquí va su dominio; varios se separan con comas.
CORS_ORIGINS=http://localhost:8081

# ── HTTPS ────────────────────────────────────────────────────
# Déjalo vacío o en false en tu equipo: aquí la API habla HTTP puro
# y forzar HTTPS la dejaría inalcanzable. En el proveedor, donde hay
# TLS delante, ponlo en true.
HTTPS_ENFORCE=false

# ── Correo saliente ──────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SENDER=
EMAIL_SENDER_NAME=RecyRoute
# En Gmail no es la contraseña de la cuenta, sino una "contraseña de
# aplicación" que se genera aparte y se puede revocar sola.
EMAIL_PASSWORD=

# ── Administrador inicial ────────────────────────────────────
# Solo se usan contra una base de datos VACÍA. Si ya existe un
# administrador, la siembra no se ejecuta y esto se ignora.
#
# Si dejas ADMIN_PASSWORD en blanco, la API genera una contraseña
# aleatoria en el primer arranque y la escribe UNA sola vez en el
# log, marcada como CRITICAL. Búscala ahí y cámbiala al entrar.
#
# Todas son opcionales; las cuatro de abajo tienen valor por defecto
# y no son secretas. La contraseña es la única que no lo tiene.
ADMIN_EMAIL=admin@recyroute.com
ADMIN_PASSWORD=
ADMIN_DOCUMENT_NUMBER=1000000000
ADMIN_NAME=Administrador
ADMIN_LAST_NAME=RecyRoute
